# Public Spotify client ID from https://developer.spotify.com/dashboard
# Keep the client secret out of this file. Vite embeds every VITE_ value in the
# browser bundle, and the app authorises with PKCE, which does not use the secret.
VITE_SPOTIFY_CLIENT_ID=your-spotify-client-id

# A Spotify-legal redirect. Spotify rejects localhost. HTTP is accepted only
# for 127.0.0.1 with a port. The path sent to Spotify is Vite's base, not a
# path written here.
#
# Local development (Vite base /):
#   http://127.0.0.1:5173
# Sign-in keeps this loopback host, including when the address bar says
# localhost, and the callback is http://127.0.0.1:5173/.
#
# GitHub Pages (production Vite base /runifly/):
#   The publish workflow injects the repository variable, which must be https.
#   On https://macro88.github.io/runifly/ the callback is that origin plus the
#   base: https://macro88.github.io/runifly/
# Register that exact URI in the Spotify dashboard.
VITE_REDIRECT_TARGET=http://127.0.0.1:5173
